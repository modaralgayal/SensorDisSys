FROM gcc

WORKDIR /usr/src/app

RUN apt-get update && apt-get install -y cmake

# Cache dependencies separately to speedup rebuilds
COPY CMakeLists.txt .
RUN mkdir src && touch src/main.cpp src/vec_utils.cpp src/vec_utils.h \
    && cmake -B build && cmake --build build --target glog

COPY src ./src
RUN cmake --build build -j

EXPOSE 5000

ENTRYPOINT [ "./build/SensorDisSys", "5000" ]